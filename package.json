{
  "name": "beans-editor",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "yarn i18n && svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json && tsc -p tsconfig.test.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "yarn check && yarn lint && yarn test && yarn build && yarn size",
    "size": "node scripts/check-size.mjs",
    "deploy": "yarn build && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "protobufjs": "^8.8.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.48.0",
    "bits-ui": "^2.19.3",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "valibot": "^1.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}
