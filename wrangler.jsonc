{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beans-editor",
  "compatibility_date": "2026-09-01",
  // Static assets only: there is no backend.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // No "routes" on purpose: the repository doesn't name a hostname. Attach a custom
  // domain in the Cloudflare dashboard (Worker › Settings › Domains & Routes); without a
  // "routes" key, deploys leave the dashboard's domains alone.
  // Production and branch Previews are served on custom domains only, so the
  // *.workers.dev URLs (production, and Version/Preview URLs) are off.
  "workers_dev": false,
  "preview_urls": false,
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches.
  // Empty: there are no bindings or vars, so Previews need no settings of their own.
  "previews": {},
  // Workers Logs: keep request (invocation) logs so traffic stats can be queried in the dashboard.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
