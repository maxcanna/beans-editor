{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bean-editor",
  "compatibility_date": "2026-09-01",
  // Static assets only: there is no backend.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Production hostname. Cloudflare creates the DNS record and certificate on deploy;
  // massi.dev must be a zone on the same Cloudflare account.
  "routes": [{ "pattern": "beans.massi.dev", "custom_domain": true }],
  // Keep *.workers.dev so branch preview URLs keep working.
  "workers_dev": true,
  "preview_urls": true,
}
